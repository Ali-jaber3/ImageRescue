<Window x:Class="ImageRescue.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ImageRescue" Width="1100" Height="820" MinWidth="760" MinHeight="520"
 Background="{DynamicResource Page}" Foreground="{DynamicResource Text}"
 FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="18,10"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Frame" Background="{TemplateBinding Background}"
      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
      CornerRadius="12" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource Field}"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Padding" Value="12"/>
   <Setter Property="Height" Value="44"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
     </Border>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="ItemFrame" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="8">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="{DynamicResource Surface}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="MinHeight" Value="42"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid>
      <ToggleButton Focusable="False" ClickMode="Press"
       IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="11">
         <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,3" Foreground="{DynamicResource Muted}"/>
        </Border>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
       Margin="12,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
       <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,4,0,0"
        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
        <ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer>
       </Border>
      </Popup>
     </Grid>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="CardStyle" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource Card}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="CornerRadius" Value="22"/>
   <Setter Property="Padding" Value="22"/>
   <Setter Property="Margin" Value="0,0,0,18"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="Padding" Value="12"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
 </Window.Resources>
 <!-- A bounded outer viewer fixes scrolling when the window is short. -->
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
  CanContentScroll="False" PanningMode="VerticalOnly">
  <StackPanel x:Name="RootLayout" Margin="26">
   <WrapPanel Margin="0,0,0,20">
    <StackPanel Width="360" Margin="0,0,18,10">
     <TextBlock Text="ImageRescue" FontSize="30" FontWeight="Bold"/>
     <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Margin="8,0,8,8">
     <TextBlock x:Name="LanguageLabel" Margin="0,0,0,6" Foreground="{DynamicResource Muted}"/>
     <ComboBox x:Name="LanguageSelector" Width="125" FlowDirection="LeftToRight" SelectionChanged="Language_Changed">
      <ComboBoxItem Content="English"/><ComboBoxItem Content="العربية"/>
     </ComboBox>
    </StackPanel>
    <StackPanel Margin="8,0,0,8">
     <TextBlock x:Name="ThemeLabel" Margin="0,0,0,6" Foreground="{DynamicResource Muted}"/>
     <ComboBox x:Name="ThemeSelector" Width="145" FlowDirection="LeftToRight" SelectionChanged="Theme_Changed">
      <ComboBoxItem x:Name="DarkThemeItem"/><ComboBoxItem x:Name="LightThemeItem"/><ComboBoxItem x:Name="GrayThemeItem"/>
     </ComboBox>
    </StackPanel>
   </WrapPanel>
   <Border Style="{StaticResource CardStyle}">
    <StackPanel>
     <TextBlock x:Name="SetupTitle" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <TextBlock x:Name="SourceLabel" Margin="0,0,0,8"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="DeviceSelector" MinWidth="220" SelectionChanged="Device_Changed"/>
      <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click"/>
     </Grid>
     <WrapPanel Margin="0,8,0,12">
      <Button x:Name="BrowseButton" Click="BrowseImage_Click"/>
      <Button x:Name="OpenOutputButton" Click="OpenOutput_Click" IsEnabled="False"/>
     </WrapPanel>
     <TextBox x:Name="SourcePathBox" IsReadOnly="True" FlowDirection="LeftToRight" HorizontalScrollBarVisibility="Hidden"/>
     <TextBlock x:Name="DestinationLabel" Margin="0,18,0,8"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="DestinationPathBox" IsReadOnly="True" FlowDirection="LeftToRight" HorizontalScrollBarVisibility="Hidden"/>
      <Button x:Name="FolderButton" Grid.Column="1" Click="ChooseFolder_Click"/>
     </Grid>
     <TextBlock x:Name="SupportText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,16,0,10"/>
     <WrapPanel>
      <Button x:Name="ScanButton" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}" Click="StartScan_Click"/>
      <Button x:Name="CancelButton" Click="Cancel_Click" IsEnabled="False"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource CardStyle}">
    <StackPanel>
     <TextBlock x:Name="ResultsTitle" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/>
     <!-- Fixed viewport preserves virtualization and gives the results their own scrollbar. -->
     <DataGrid x:Name="ResultsGrid" Height="280" AutoGenerateColumns="False" IsReadOnly="True"
      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="38"
      Background="{DynamicResource Card}" RowBackground="{DynamicResource Card}" AlternatingRowBackground="{DynamicResource Surface}"
      BorderThickness="0" GridLinesVisibility="None" EnableRowVirtualization="True"
      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
      PreviewMouseWheel="Results_MouseWheel">
      <DataGrid.Columns>
       <DataGridTextColumn x:Name="FileColumn" Binding="{Binding FileName}" Width="*" MinWidth="230"/>
       <DataGridTextColumn x:Name="TypeColumn" Binding="{Binding FileType}" Width="80"/>
       <DataGridTextColumn x:Name="SizeColumn" Binding="{Binding FileSize}" Width="110"/>
       <DataGridTextColumn x:Name="OffsetColumn" Binding="{Binding Offset}" Width="130"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <ProgressBar x:Name="ScanProgress" Height="8" Minimum="0" Maximum="100" Background="{DynamicResource Surface}" Foreground="{DynamicResource Accent}" BorderThickness="0"/>
   <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,12"/>
  </StackPanel>
 </ScrollViewer>
</Window>
