<Window x:Class="ImageRescue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageRescue"
        Width="1100" Height="820"
        MinWidth="850" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Page}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- Rounded buttons -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="12">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Frame"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Path fields -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemFrame"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemFrame"
                                        Property="Background"
                                        Value="{DynamicResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded dropdowns -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource Field}"
                                                BorderBrush="{DynamicResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="11">
                                            <TextBlock Text="⌄"
                                                       Foreground="{DynamicResource Muted}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,4"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="12,0,32,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Card}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="5"
                                        Margin="0,5,0,0"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="20"
                                      ShadowDepth="3"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootLayout" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource Surface}"
                            CornerRadius="14"
                            Padding="12,9"
                            Margin="0,0,12,0">
                        <TextBlock Text="IR"
                                   Foreground="{DynamicResource Accent}"
                                   FontSize="22"
                                   FontWeight="Bold"/>
                    </Border>

                    <TextBlock Text="ImageRescue"
                               FontSize="30"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="SubtitleText"
                           Foreground="{DynamicResource Muted}"
                           Margin="0,12,20,0"
                           MaxWidth="440"
                           HorizontalAlignment="Left"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14"
                    Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="LanguageLabel"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="LanguageSelector"
                                  Width="125"
                                  FlowDirection="LeftToRight"
                                  SelectionChanged="Language_Changed">
                            <ComboBoxItem Content="English"/>
                            <ComboBoxItem Content="العربية"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock x:Name="ThemeLabel"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="ThemeSelector"
                                  Width="145"
                                  FlowDirection="LeftToRight"
                                  SelectionChanged="Theme_Changed">
                            <ComboBoxItem x:Name="DarkThemeItem"/>
                            <ComboBoxItem x:Name="LightThemeItem"/>
                            <ComboBoxItem x:Name="GrayThemeItem"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recovery setup -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="SetupTitle"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="SourceLabel"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SourcePathBox"
                             IsReadOnly="True"
                             FlowDirection="LeftToRight"
                             HorizontalScrollBarVisibility="Hidden"/>

                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            MinWidth="145"
                            Margin="12,0,0,0"
                            Click="BrowseImage_Click"/>
                </Grid>

                <TextBlock x:Name="DestinationLabel"
                           Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="DestinationPathBox"
                             IsReadOnly="True"
                             FlowDirection="LeftToRight"
                             HorizontalScrollBarVisibility="Hidden"/>

                    <Button x:Name="FolderButton"
                            Grid.Column="1"
                            MinWidth="145"
                            Margin="12,0,0,0"
                            Click="ChooseFolder_Click"/>
                </Grid>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SupportText"
                               Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,16,0"/>

                    <Button x:Name="ScanButton"
                            Grid.Column="1"
                            Background="{DynamicResource Accent}"
                            Foreground="{DynamicResource AccentText}"
                            BorderThickness="0"
                            MinWidth="145"
                            Click="StartScan_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ResultsTitle"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="ResultsGrid"
                              Background="{DynamicResource Card}"
                              RowBackground="{DynamicResource Card}"
                              AlternatingRowBackground="{DynamicResource Surface}"
                              BorderThickness="0"
                              GridLinesVisibility="None"
                              RowHeight="44"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="FileColumn"
                                                Binding="{Binding FileName}"
                                                Width="*"/>
                            <DataGridTextColumn x:Name="TypeColumn"
                                                Binding="{Binding FileType}"
                                                Width="85"/>
                            <DataGridTextColumn x:Name="SizeColumn"
                                                Binding="{Binding FileSize}"
                                                Width="100"/>
                            <DataGridTextColumn x:Name="StatusColumn"
                                                Binding="{Binding Status}"
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,45,0,0"
                                IsHitTestVisible="False">
                        <TextBlock Text="◇"
                                   FontSize="32"
                                   Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyTitle"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="12"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Status -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <ProgressBar x:Name="ScanProgress"
                         Height="6"
                         Minimum="0"
                         Maximum="100"
                         Background="{DynamicResource Surface}"
                         Foreground="{DynamicResource Accent}"
                         BorderThickness="0"/>

            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource Muted}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

    </Grid>
</Window>