<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="../../src/ImageRescue.App/Recovery/Carver.cs" Link="Carver.cs"/>
  <Compile Include="../../src/ImageRescue.App/Recovery/AdditionalFormats.cs" Link="AdditionalFormats.cs"/>
  <Compile Include="../../src/ImageRescue.App/Recovery/ResultFiles.cs" Link="ResultFiles.cs"/>
  <Compile Include="../../src/ImageRescue.App/Recovery/PhotoMetadata.cs" Link="PhotoMetadata.cs"/>
  <Compile Include="../../src/ImageRescue.App/Presentation/Preferences.cs" Link="Preferences.cs"/>
  <Content Include="../../src/ImageRescue.App/Assets/Languages/*.json" Link="Languages/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
